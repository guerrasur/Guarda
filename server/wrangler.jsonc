{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "guarda-drive",
  "main": "worker.js",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "vars": {
    "APP_ORIGIN": "https://guerrasur.github.io",
    "PUBLIC_ORIGIN": "https://guarda-drive.luchoguerra33.workers.dev",
    "GOOGLE_CLIENT_ID": "613370054779-e57i4ngllcd5t1vdivgl7qpfodon7ro9.apps.googleusercontent.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "guarda-drive",
      "database_id": "7f37b18e-64e8-4e2f-ad26-63be61f7e3eb",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "ratelimits": [
    {
      "name": "IP_LIMIT",
      "namespace_id": "420790",
      "simple": {
        "limit": 600,
        "period": 60
      }
    },
    {
      "name": "BEGIN_LIMIT",
      "namespace_id": "420791",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "NAV_LIMIT",
      "namespace_id": "420792",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "SESSION_LIMIT",
      "namespace_id": "420793",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "REFRESH_LIMIT",
      "namespace_id": "420794",
      "simple": {
        "limit": 4,
        "period": 60
      }
    }
  ],
  "keep_vars": true
}
